{
  "name": "vest-copier",
  "version": "0.37.0",
  "private": true,
  "description": "STRATUH Copier: a Tampermonkey userscript that copies a master Vest account's trades to your other Vest accounts.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "npm run build && node --test test/*.test.mjs",
    "format": "prettier --write src test rollup.config.mjs",
    "format:check": "prettier --check src test rollup.config.mjs"
  },
  "devDependencies": {
    "jsdom": "^24.1.3",
    "prettier": "^3.3.3",
    "rollup": "^4.24.0"
  },
  "engines": {
    "node": ">=18"
  }
}
